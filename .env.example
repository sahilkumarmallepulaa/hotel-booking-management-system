# ==============================================================================
# GrandStay – Backend Microservices Environment Variables Template
# Copy this file to your system/shell environment or run with these variables set.
# ==============================================================================

# Database Connection (Used by Hotel, Booking, and User Services)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=

# JWT Configuration (Must be identical across User Service and Booking Service)
# Must be at least 256 bits (32+ characters) for HMAC-SHA256 signing
JWT_SECRET=your_secure_256_bit_secret_key_at_least_32_characters_long

# Service Ports (Defaults shown; configured in application.properties)
# EUREKA_SERVER_PORT=8761
# HOTEL_SERVICE_PORT=8081
# BOOKING_SERVICE_PORT=8082
# USER_SERVICE_PORT=8083

# Note for Frontend:
# For frontend configuration, refer to frontend/.env.example:
# VITE_HOTEL_SERVICE_URL=http://localhost:8081
# VITE_BOOKING_SERVICE_URL=http://localhost:8082
# VITE_USER_SERVICE_URL=http://localhost:8083
